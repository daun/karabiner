{
  "name": "karabiner",
  "version": "1.0.0",
  "private": true,
  "author": "Philipp Daun <daun@daun.ltd>",
  "contributors": [
    "Max Stoiber <contact@mxstbr.com>"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=12.0.0"
  },
  "packageManager": "npm@12.0.1",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "tsx rules.ts",
    "watch": "tsx watch rules.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "verify": "npm run typecheck && npm run format:check && npm run build",
    "reload": "launchctl kickstart -k gui/$(id -u)/org.pqrs.service.agent.karabiner_console_user_server",
    "deploy": "npm run build && npm run reload",
    "bootstrap": "./bootstrap.sh"
  }
}
