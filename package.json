{
  "name": "karabiner",
  "version": "1.0.0",
  "private": true,
  "author": "Philipp Daun <daun@daun.ltd>",
  "contributors": [
    "Max Stoiber <contact@mxstbr.com>"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=12.0.0"
  },
  "packageManager": "npm@12.0.1",
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^26.1.2",
    "karabiner.ts": "^1.38.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "tsx src/build.ts",
    "watch": "tsx watch src/build.ts",
    "keymap": "tsx src/keymap.ts",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "verify": "npm run typecheck && npm run check && npm run build",
    "reload": "launchctl kickstart -k gui/$(id -u)/org.pqrs.service.agent.karabiner_console_user_server",
    "deploy": "npm run build && npm run reload"
  }
}
